#!/usr/bin/env bash
# Prepares a fresh Amp orb: the pnpm version `packageManager` pins, the workspace dependencies, and
# the playground's generated Nuxt types. Reruns on a stale snapshot, so every step is cheap when warm.
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  local start=$SECONDS
  echo "› $1"
  shift
  "$@"
  echo "  done in $((SECONDS - start))s"
}

pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
if [ "$(pnpm --version 2>/dev/null || true)" != "$pnpm_version" ]; then
  step "Installing pnpm $pnpm_version" sudo npm install --global --force "pnpm@$pnpm_version"
fi

echo "node $(node --version), pnpm $(pnpm --version)"

step "Installing workspace dependencies" pnpm install --frozen-lockfile
# Generated types under playground/.nuxt, needed by `pnpm typecheck` and editors.
step "Preparing the playground" pnpm dev:prepare

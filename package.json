{
  "name": "comark-docs",
  "version": "0.0.1",
  "description": "Nuxt layer for content-driven documentation sites powered by comark-content",
  "type": "module",
  "main": "./nuxt.config.ts",
  "types": "./index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comarkdown/comark-docs.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "app",
    "server",
    "shared",
    "modules",
    "utils",
    "docs",
    "nuxt.config.ts",
    "nuxt.schema.ts",
    "index.d.ts",
    "lint.mjs",
    "README.md"
  ],
  "scripts": {
    "dev": "nuxt dev playground",
    "dev:trace": "OTEL_TRACES_EXPORTER=otlp OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf OTEL_SERVICE_NAME=comark-content nuxt dev playground",
    "build": "nuxt build playground",
    "generate": "nuxt generate playground",
    "typecheck": "nuxt typecheck playground",
    "lint": "eslint . && pnpm lint:content",
    "lint:content": "cd playground && comark-lint \"content/**/*.md\"",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:vercel": "vitest run --project vercel",
    "test:smoke": "vitest run --project smoke",
    "test:watch": "vitest --project unit",
    "dev:prepare": "nuxt prepare playground"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.138",
    "@ai-sdk/vue": "^4.0.165",
    "@comark/nuxt": "^0.9.0",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/unjs": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.96",
    "@iconify/vue": "^5.0.5",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mcp-toolkit": "^0.24.3",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.0",
    "@vercel/global-config": "^1.5.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.165",
    "beautiful-mermaid": "^1.1.3",
    "comark": "^0.9.0",
    "comark-content": "^0.5.1",
    "defu": "^6.1.7",
    "exsolve": "^1.2.0",
    "forges": "^0.3.2",
    "jiti": "^2.7.0",
    "js-yaml": "^5.5.0",
    "motion-v": "^2.11.1",
    "nuxt-agent-discovery": "^0.8.1",
    "nuxt-llms": "^0.3.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-schema-org": "^7.0.1",
    "nuxt-seo-utils": "^9.0.1",
    "nuxt-workers": "^0.1.0",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3",
    "rangi": "^2.2.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.6",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "nuxt": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools-kit": "4.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "comark-linter": "^0.10.0",
    "es-module-lexer": "^3.0.4",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.13"
  }
}
